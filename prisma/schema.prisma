generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  emailVerified  Boolean        @default(false)
  name           String?
  avatarUrl      String?
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastLoginAt    DateTime?
  authAccounts   AuthAccount[]
  projects       Project[]
  uploadedAssets Asset[]
  requestedJobs  PipelineJob[]
  refreshTokens  RefreshToken[]
  creativeRevisions CreativeRevision[]
  creativeApprovals CreativeApproval[]

  @@map("users")
}

model AuthAccount {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_accounts")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ads         Ad[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("projects")
}

model Ad {
  id              String         @id @default(uuid())
  projectId       String
  title           String
  status          AdStatus       @default(DRAFT)
  productName     String?
  brandName       String?
  category        String?
  referenceNotes  String?
  objective       String?
  platform        String?
  aspectRatio     String?
  durationSeconds Int?
  creativeBrief   Json?
  pipelineSpec    Json?
  workflowMode    WorkflowMode @default(LEGACY_AUTOMATIC)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets          Asset[]
  pipelineJobs    PipelineJob[]
  providerJobs    ProviderJob[]
  renderOutputs   RenderOutput[]
  shots           Shot[]
  artifacts       CreativeArtifact[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("ads")
}

model Asset {
  id              String      @id @default(uuid())
  adId            String
  uploadedById    String
  kind            AssetKind   @default(OTHER)
  status          AssetStatus @default(REGISTERED)
  fileName        String
  mimeType        String
  sizeBytes       Int?
  storageProvider String
  storageKey      String
  url             String?
  checksum        String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  ad              Ad          @relation(fields: [adId], references: [id], onDelete: Cascade)
  uploadedBy      User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([adId])
  @@index([uploadedById])
  @@map("assets")
}

model PipelineJob {
  id             String            @id @default(uuid())
  adId           String
  requestedById  String
  type           PipelineJobType   @default(AD_GENERATION)
  status         PipelineJobStatus @default(QUEUED)
  priority       Int               @default(0)
  provider       String?
  externalJobId  String?
  requestPayload Json?
  resultPayload  Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  ad             Ad                @relation(fields: [adId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  snapshotHash   String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  cancelRequestedAt DateTime?
  creativeRevisions CreativeRevision[]
  requestedBy    User              @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  stepRuns       PipelineStepRun[]
  providerJobs   ProviderJob[]
  renderOutputs  RenderOutput[]

  @@index([adId])
  @@index([requestedById])
  @@index([status])
  @@map("pipeline_jobs")
  @@unique([adId, idempotencyKey])
  @@index([status, leaseExpiresAt])
}

model PipelineStepRun {
  id             String             @id @default(uuid())
  jobId          String
  name           String
  status         PipelineStepStatus @default(PENDING)
  sequence       Int
  provider       String?
  externalStepId String?
  inputPayload   Json?
  outputPayload  Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  job            PipelineJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerJobs   ProviderJob[]

  @@unique([jobId, sequence])
  @@index([jobId])
  @@map("pipeline_step_runs")
}

model RenderOutput {
  id              String           @id @default(uuid())
  adId            String
  jobId           String?
  kind            RenderOutputKind
  storageProvider String
  storageKey      String
  url             String?
  mimeType        String?
  sizeBytes       Int?
  width           Int?
  height          Int?
  durationMs      Int?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ad              Ad               @relation(fields: [adId], references: [id], onDelete: Cascade)
  job             PipelineJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([adId])
  @@index([jobId])
  @@map("render_outputs")
}

model Shot {
  id              String     @id @default(uuid())
  adId            String
  shotNumber      Int
  role            String
  status          ShotStatus @default(PLANNED)
  durationSeconds Int
  promptPayload   Json
  keyframeAssetId String?
  videoAssetId    String?
  keyframeRevisionId String?
  videoRevisionId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  ad              Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  artifacts       CreativeArtifact[]

  @@unique([adId, shotNumber])
  @@index([adId])
  @@map("shots")
}

model ProviderJob {
  id             String             @id @default(uuid())
  adId           String
  jobId          String?
  stepRunId      String?
  provider       String
  model          String?
  operationId    String?
  status         ProviderJobStatus  @default(QUEUED)
  requestPayload Json?
  responsePayload Json?
  requestFingerprint String?
  attemptState   String?
  metadata       Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  ad             Ad                 @relation(fields: [adId], references: [id], onDelete: Cascade)
  job            PipelineJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  stepRun        PipelineStepRun?   @relation(fields: [stepRunId], references: [id], onDelete: SetNull)

  @@index([adId])
  @@index([jobId])
  @@index([stepRunId])
  @@index([status])
  @@map("provider_jobs")
  @@unique([jobId, requestFingerprint])
}

enum AuthProvider {
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AdStatus {
  DRAFT
  READY
  GENERATING
  COMPLETED
  FAILED
  ARCHIVED
}

enum AssetKind {
  PRODUCT_IMAGE
  REFERENCE_IMAGE
  LOGO
  BRAND_GUIDE
  OTHER
}

enum AssetStatus {
  REGISTERED
  READY
  FAILED
}

enum PipelineJobType {
  AD_GENERATION
  GUIDED_GENERATION
  RENDER_EXPORT
}

model CreativeArtifact {
  id                 String @id @default(uuid())
  adId               String
  kind               CreativeArtifactKind
  scopeKey           String @default("root")
  shotId             String?
  currentRevisionId  String? @unique
  approvedRevisionId String? @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  ad                 Ad @relation(fields: [adId], references: [id], onDelete: Cascade)
  shot               Shot? @relation(fields: [shotId], references: [id], onDelete: Cascade)
  revisions          CreativeRevision[] @relation("ArtifactRevisions")
  approvals          CreativeApproval[]
  currentRevision    CreativeRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevision   CreativeRevision? @relation("ApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)

  @@unique([adId, kind, scopeKey])
  @@index([adId])
  @@map("creative_artifacts")
}

model CreativeRevision {
  id                String @id @default(uuid())
  artifactId        String
  version           Int
  content           Json
  sourceRevisionIds String[]
  origin            String
  schemaVersion     Int @default(1)
  authorId          String?
  sourceJobId       String?
  parentRevisionId  String?
  createdAt         DateTime @default(now())
  artifact          CreativeArtifact @relation("ArtifactRevisions", fields: [artifactId], references: [id], onDelete: Cascade)
  currentFor        CreativeArtifact? @relation("CurrentRevision")
  approvedFor       CreativeArtifact? @relation("ApprovedRevision")
  author            User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceJob         PipelineJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  parentRevision    CreativeRevision? @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions    CreativeRevision[] @relation("RevisionParent")
  approvals         CreativeApproval[]

  @@unique([artifactId, version])
  @@index([artifactId])
  @@map("creative_revisions")
}

enum CreativeArtifactKind {
  SCRIPT
  STORYBOARD
  SHOT_PLAN
  TIMELINE
}

enum WorkflowMode {
  LEGACY_AUTOMATIC
  GUIDED
}

model CreativeApproval {
  id          String @id @default(uuid())
  artifactId  String
  revisionId  String
  approvedById String
  createdAt   DateTime @default(now())
  artifact    CreativeArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  revision    CreativeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  approvedBy  User @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([artifactId, revisionId, approvedById])
  @@map("creative_approvals")
}

enum PipelineJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PipelineStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ShotStatus {
  PLANNED
  KEYFRAME_READY
  VIDEO_READY
  FAILED
}

enum ProviderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum RenderOutputKind {
  VIDEO
  IMAGE
  SCRIPT
  METADATA
}
