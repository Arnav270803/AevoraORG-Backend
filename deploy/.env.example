# Production settings. Copy to deploy/.env on the server and fill in.
# deploy/.env is gitignored: never commit it.

# Public API address (Caddy gets its HTTPS certificate for this name) and the
# Vercel frontend URL allowed to call it.
API_DOMAIN=aevora-api.duckdns.org
FRONTEND_ORIGIN=https://your-project.vercel.app

# Secrets: generate each one with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AEVORA_PIPELINE_SERVICE_TOKEN=

# Google sign-in: the same client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# S3 bucket, its region, the CloudFront URL in front of it, and the access key
# limited to that bucket.
S3_BUCKET=
S3_REGION=ap-south-1
MEDIA_PUBLIC_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker. "mock" makes no paid calls; set "ltx" for real video generation.
PIPELINE_PROVIDER_MODE=mock
OPENROUTER_API_KEY=
LTX_API_KEY=
