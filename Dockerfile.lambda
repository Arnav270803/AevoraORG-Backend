# AWS Lambda image for the API: the same build as Dockerfile, plus the AWS Lambda Web
# Adapter, which runs the unchanged Express server inside Lambda and forwards Function
# URL requests to it.
FROM node:22-bookworm-slim

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npx prisma generate && npm run build

# Database migrations run once from your computer (npx prisma migrate deploy), not on every cold start.
ENV NODE_ENV=production PORT=8080 AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/api/health

CMD ["node", "dist/server.js"]
